---
type Variant = 'lockup' | 'monogram' | 'wordmark';

interface Props {
  variant?: Variant;
  class?: string;
  width?: number;
  height?: number;
}

const { variant = 'lockup', class: className = '', width, height } = Astro.props;
// Transparent raster extractions from assets-source/VeloreLogo.jpeg; swap the paths if a client SVG is supplied later.
const LOGO_PATHS: Record<Variant, string> = {
  lockup: '/brand/logo-lockup.png',
  monogram: '/brand/monogram.png',
  wordmark: '/brand/wordmark.png',
};
const DEFAULT_DIMENSIONS: Record<Variant, { width: number; height: number }> = {
  lockup: { width: 360, height: 276 },
  monogram: { width: 88, height: 90 },
  wordmark: { width: 360, height: 86 },
};
const dimensions = DEFAULT_DIMENSIONS[variant];
const altText: Record<Variant, string> = {
  lockup: 'Velore Eau de Parfum logo',
  monogram: 'Velore monogram',
  wordmark: 'Velore wordmark and Eau de Parfum tagline',
};
---
<img
  src={LOGO_PATHS[variant]}
  alt={altText[variant]}
  width={width ?? dimensions.width}
  height={height ?? dimensions.height}
  class={className}
  loading={variant === 'lockup' ? 'eager' : 'lazy'}
  decoding="async"
/>
