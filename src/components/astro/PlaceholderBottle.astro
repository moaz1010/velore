---
interface Props {
  name?: string;
  label?: string;
  class?: string;
}

const { name = 'Placeholder fragrance', label = 'SAMPLE', class: className = '' } = Astro.props;
const gradientId = `bottle-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<svg
  class={className}
  viewBox="0 0 640 800"
  width="640"
  height="800"
  role="img"
  aria-label={`${name} — placeholder bottle illustration, not product photography`}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${gradientId}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#262626" />
      <stop offset="0.52" stop-color="#141414" />
      <stop offset="1" stop-color="#8e7340" stop-opacity=".84" />
    </linearGradient>
    <linearGradient id={`${gradientId}-gold`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8e7340" />
      <stop offset=".5" stop-color="#d4af37" />
      <stop offset="1" stop-color="#c5a059" />
    </linearGradient>
    <radialGradient id={`${gradientId}-glow`} cx="50%" cy="45%" r="54%">
      <stop offset="0" stop-color="#c5a059" stop-opacity=".13" />
      <stop offset="1" stop-color="#0b0b0b" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="640" height="800" fill="#0b0b0b" />
  <rect width="640" height="800" fill={`url(#${gradientId}-glow)`} />
  <ellipse cx="320" cy="690" rx="174" ry="25" fill="#000" opacity=".7" />
  <rect x="264" y="152" width="112" height="54" rx="8" fill="#1c1c1c" stroke="#8e7340" stroke-opacity=".7" />
  <path d="M288 206h64v65l22 28v19H266v-19l22-28z" fill="#141414" stroke={`url(#${gradientId}-gold)`} stroke-width="2" />
  <path
    d="M206 318q0-20 20-20h188q20 0 20 20v312q0 36-36 36H242q-36 0-36-36z"
    fill={`url(#${gradientId}-glass)`}
    stroke={`url(#${gradientId}-gold)`}
    stroke-opacity=".78"
    stroke-width="3"
  />
  <path d="M232 328v274q0 20 14 26" fill="none" stroke="#f5f2eb" stroke-opacity=".14" stroke-width="6" />
  <rect x="230" y="407" width="180" height="139" rx="2" fill="#0b0b0b" fill-opacity=".75" stroke="#c5a059" stroke-opacity=".62" />
  <path d="M289 448q31-49 62 0" fill="none" stroke={`url(#${gradientId}-gold)`} stroke-width="4" />
  <text x="320" y="478" fill="#f5f2eb" text-anchor="middle" font-family="Georgia,serif" font-size="22" letter-spacing="7">V</text>
  <text x="320" y="513" fill="#c5a059" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" letter-spacing="4">{label}</text>
  <text x="320" y="735" fill="#cfcac0" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" letter-spacing="3">PLACEHOLDER ILLUSTRATION</text>
</svg>
