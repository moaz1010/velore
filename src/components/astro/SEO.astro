---
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/brand/og-image.png', noindex = false } = Astro.props;
const configuredOrigin = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/$/, '');
const canonical = configuredOrigin ? new URL(Astro.url.pathname, configuredOrigin).toString() : undefined;
const socialImage = configuredOrigin ? new URL(image, configuredOrigin).toString() : undefined;
const keywords = 'Velore, fragrance, perfume, eau de parfum, Egypt';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Velore" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
