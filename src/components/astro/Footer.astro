---
import Logo from '@/components/astro/Logo.astro';
import FooterDetails from '@/components/react/social/FooterDetails';
const instagramHandle = import.meta.env.PUBLIC_INSTAGRAM_HANDLE?.trim() || 'velo.re15';
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.trim() || '';
---
<footer class="site-footer">
  <div class="site-footer__inner container-editorial">
    <div class="site-footer__brand">
      <Logo variant="lockup" width={206} height={172} />
      <p>Fragrance, discovered at your own pace.</p>
    </div>
    <nav class="site-footer__links" aria-label="Footer navigation">
      <a href="/shop">Collection</a>
      <a href="/discovery-sets">Discovery sets</a>
      <a href="/about">Our story</a>
      <a href="/delivery">Delivery</a>
      <a href="/contact">Contact</a>
    </nav>
    <FooterDetails
      client:visible
      initialInstagramHandle={instagramHandle}
      initialWhatsappNumber={whatsappNumber}
    />
  </div>
  <div class="site-footer__bottom container-editorial">
    <span>© {new Date().getFullYear()} Velore</span>
    <span>Orders are sent by WhatsApp inquiry.</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4.5rem 1.5rem;
    border-top: 1px solid rgb(197 160 89 / 18%);
    background: #090909;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(15rem, 1.3fr) 1fr 1fr;
    gap: 3rem;
    align-items: start;
    padding-bottom: 3.5rem;
  }

  .site-footer__brand p,
  .site-footer__links {
    color: var(--ivory-dim);
    font-size: 0.77rem;
  }

  .site-footer__brand img {
    margin-inline-start: -0.5rem;
  }

  .site-footer__brand p {
    max-width: 25ch;
    margin-top: 0.8rem;
  }

  .site-footer__links {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.4rem;
  }

  .site-footer__links a:hover {
    color: var(--gold);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(197 160 89 / 14%);
    color: #aaa59b;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 700px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      flex-direction: column;
    }
  }
</style>
