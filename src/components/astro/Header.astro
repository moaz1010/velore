---
import Logo from '@/components/astro/Logo.astro';
import InquiryBadge from '@/components/react/inquiry/InquiryBadge';
import AnnouncementBar from '@/components/react/social/AnnouncementBar';
import '@/styles/inquiry.css';
---
<AnnouncementBar client:load />
<header class="site-header">
  <div class="site-header__inner container-editorial">
    <a class="site-header__brand" href="/" aria-label="Velore home">
      <Logo variant="monogram" width={54} height={54} />
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      <a href="/shop">Collection</a>
      <a href="/discovery-sets">Discovery sets</a>
      <a href="/about">Our story</a>
    </nav>
    <InquiryBadge client:load />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid rgb(197 160 89 / 16%);
    background: rgb(11 11 11 / 92%);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.8rem);
    color: var(--ivory-dim);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-header__nav a {
    transition: color 180ms ease;
  }

  .site-header__nav a:hover {
    color: var(--gold);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      min-height: 4.5rem;
      gap: 0.8rem;
    }

    .site-header__nav {
      gap: 0.8rem;
      font-size: 0.57rem;
      letter-spacing: 0.08em;
    }

    .site-header__nav a:nth-child(3) {
      display: none;
    }
  }
</style>
